# ==========================================================
# Project Hub — ตัวอย่างไฟล์ค่าตั้งต้นของระบบ (.env.example)
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องของคุณ
#   Windows : copy .env.example .env
#   macOS/Linux : cp .env.example .env
# ==========================================================

# ---------- เซิร์ฟเวอร์ ----------
NODE_ENV=development
PORT=3000
# URL หลักของเว็บไซต์ (ใช้สร้าง canonical / sitemap / ลิงก์แชร์)
SITE_URL=http://localhost:3000

# ---------- ฐานข้อมูล MySQL / MariaDB ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=project_hub
DB_CONNECTION_LIMIT=10

# ---------- ความปลอดภัย / Session ----------
# ความลับสำหรับเซ็นคุกกี้ session (ต้องยาวและสุ่มสุ่ม) เปลี่ยนก่อนใช้งานจริง!
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_NAME=ph_sid
# อายุ session (ชั่วโมง) และการบังคับ cookie ผ่าน HTTPS
SESSION_HOURS=8
COOKIE_SECURE=false
# เปิด CSRF protection (แนะนำให้เปิดเสมอ)
ENABLE_CSRF=true

# ---------- ระบบเข้าสู่ระบบ ----------
# จำนวนครั้งที่ล็อกอินผิดได้ก่อนถูกล็อก และระยะเวลาล็อก (นาที)
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# ---------- บัญชี Admin เริ่มต้น (ใช้กับ npm run create-admin) ----------
ADMIN_EMAIL=admin@nexuscamp.local
ADMIN_NAME=ผู้ดูแลระบบ
# ต้องยาวอย่างน้อย 8 ตัวอักษร และมีตัวอักษรกับตัวเลข
ADMIN_PASSWORD=Admin@12345

# ---------- การอัปโหลดไฟล์ ----------
# โฟลเดอร์เก็บไฟล์อัปโหลด (relative จาก root โปรเจกต์)
UPLOAD_DIR=backend/uploads
MAX_IMAGE_MB=8
MAX_VIDEO_MB=80